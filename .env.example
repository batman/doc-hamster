# DocHamster configuration. Copy to `.env` and fill in – never commit `.env`.
# Placeholders only: example.com, empty secrets. See docs/PLAN.md §12.

APP_NAME=DocHamster
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Fixed domain with a publicly trusted TLS certificate (D-010). Passkeys are
# bound to this domain – choose it once and never change it.
APP_URL=https://dochamster.example.com

# Set to true by the setup wizard or `php artisan dochamster:setup` (D-024).
DOCHAMSTER_INSTALLED=false

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MariaDB 10.11+ (DB_CONNECTION=mariadb) or MySQL 8.4+ (DB_CONNECTION=mysql), D-003
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dochamster
DB_USERNAME=dochamster
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Background jobs: database queue, worked off by cron every minute (D-010).
# Queues: 'local' (no outbound network) and 'net' (bank modules, mail), D-020.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="dochamster@example.com"
MAIL_FROM_NAME="${APP_NAME}"
