#!/bin/sh
# Blocks commits that contain secrets (AGENTS.md, public repository rules).
# Enable once per clone:  composer hooks   (= git config core.hooksPath .githooks)
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not installed – install it before committing (https://github.com/gitleaks/gitleaks)." >&2
    exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
