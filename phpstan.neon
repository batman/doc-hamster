includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # PLAN §13 / PLAN-REVIEW B13: level 8 now, 9 once the codebase is stable.
    level: 8
    paths:
        - app
        - routes
        - database
        # Test doubles and fixtures, e.g. the only user of BelongsToOrg until Phase 2.
        - tests/Support
    tmpDir: .phpstan-cache
