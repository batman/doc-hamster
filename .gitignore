# Dependencies
/vendor/
/node_modules/

# Environment & secrets
.env
.env.*
!.env.example
*.key
*.pem

# Runtime data (never commit uploaded receipts) – only the folder skeleton
# with its .gitignore files is tracked
/storage/**
!/storage/**/
!/storage/**/.gitignore
/bootstrap/cache/*.php
/public/storage
/public/build
/public/hot
.phpunit.cache/
/.phpstan-cache/
/database/*.sqlite
/database/*.sqlite-*

# Tooling
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
/coverage/
/test-results/
/playwright-report/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Agent-local settings
.claude/settings.local.json

# Private material – never commit (public repo!)
/private/
/tests/fixtures/private/
/backups/
*.sql
*.sql.gz
*.dump
/deploy/*.local.*
